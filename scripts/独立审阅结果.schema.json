{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "verdict", "summary", "criteria", "issues"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["needs-fix", "passed"]
    },
    "verdict": {
      "type": "string",
      "enum": ["needs-fix", "passed"]
    },
    "summary": {
      "type": "string",
      "minLength": 80
    },
    "criteria": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "notes"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "notes": { "type": "string", "minLength": 20 }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "route", "viewport", "evidence", "detail", "target", "acceptanceReason"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocking", "major", "minor"] },
          "status": { "type": "string", "enum": ["open", "fixed", "accepted"] },
          "route": { "type": "string" },
          "viewport": { "type": "string" },
          "evidence": { "type": "string" },
          "detail": { "type": "string" },
          "target": { "type": "string" },
          "acceptanceReason": { "type": "string" }
        }
      }
    }
  }
}
